{
 "note": "Applied in order, RE2 syntax (Go regexp), to Rust golden HTML at capture time and to Go output before comparing. The Go side must also render its own version string as v0.41.1 or apply the last rule too.",
 "rules": [
  {
   "pattern": "data-ts=\"\\d+\"",
   "replace": "data-ts=\"<TS>\""
  },
  {
   "pattern": "data-date-ts=\"\\d+\"",
   "replace": "data-date-ts=\"<TS>\""
  },
  {
   "pattern": "(?:just now|\\d+ (?:seconds?|minutes?|hours?|days?|months?|years?) ago)",
   "replace": "<AGO>"
  },
  {
   "pattern": "noadd_[A-Za-z0-9_-]{4,}",
   "replace": "<APIKEY>"
  },
  {
   "pattern": "[\\d.]+((?:<span[^>]*>)?\\s?ms\\b)",
   "replace": "<MS>${1}"
  },
  {
   "pattern": "v0\\.41\\.1",
   "replace": "<VERSION>"
  }
 ]
}