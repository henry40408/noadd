# Without this file `COPY . .` ships a multi-gigabyte context.

# Shadowed by the builder's target cache mount anyway.
/target

# e2e is a separate cargo workspace; none of it reaches the binary.
/e2e

# Local runtime state — the SQLite DB carries password hashes and sessions.
**/*.sqlite3
**/*.sqlite3-*
**/*.db

# Local dev TLS material and direnv environment.
*.pem
.envrc

# The Docker workflow passes GIT_VERSION as a build arg instead.
.git
